# Copie para .env e preencha. Este arquivo NUNCA deve ser commitado (já está no .gitignore).

# --- LiveKit (mesmo servidor self-hosted que o app Electron já usa) ---
LIVEKIT_URL=wss://137-131-144-255.sslip.io
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Supabase (usa a Service Role Key, NÃO a chave pública/anon) ---
# A Service Role Key ignora RLS — por isso o bot roda só no servidor,
# nunca no Electron/cliente. Pegue em Supabase > Project Settings > API.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# UUID da conta "Echo Music Bot" criada via `node scripts/create-bot-account.mjs`
BOT_AUTHOR_ID=

# --- Limites de segurança ---
# Máximo de sessões (canais tocando música) simultâneas em todo o servidor.
# Regra prática: ~1 por OCPU disponível na VM, deixando folga pro LiveKit.
MAX_CONCURRENT_SESSIONS=4

# Duração máxima de uma única faixa antes de ser cortada automaticamente (segundos).
MAX_TRACK_SECONDS=900

# Se todo mundo sair da chamada, o bot espera este tempo (segundos) e então sai sozinho,
# parando de gastar rede, CPU e um espaço do limite de canais. 0 desliga.
EMPTY_ROOM_SECONDS=60

# Áudio deixado na fila de envio (ms). Define o atraso entre mexer no volume/pausar e ouvir a mudança.
# Menor = mais rápido, mas pode picotar em servidor sobrecarregado (nesse caso aumente).
AUDIO_QUEUE_MS=400

# Prefixo dos comandos no chat
COMMAND_PREFIX=!

# --- yt-dlp (opcional, mas geralmente necessário em servidor de datacenter) ---
# O YouTube bloqueia muitos IPs de nuvem com "Sign in to confirm you're not a bot".
# Caminho de um arquivo de cookies no formato Netscape (exportado de uma conta Google SECUNDÁRIA,
# nunca a sua pessoal — o YouTube pode restringir a conta usada):
YTDLP_COOKIES_FILE=
# Argumentos extras separados por espaço (sem espaços dentro de um argumento). Exemplo:
# YTDLP_EXTRA_ARGS=--extractor-args youtube:player_client=tv
YTDLP_EXTRA_ARGS=
