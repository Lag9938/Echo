# Copie este arquivo para .env.local e preencha com os dados em Supabase > Connect.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_chave_publica

# Configurações para empacotamento da Microsoft Store
# Obtenha estes valores no Partner Center: Gestão de produtos > Identidade do produto
MS_STORE_PUBLISHER=CN=SUA-IDENTIDADE-DE-EDITOR
MS_STORE_IDENTITY_NAME=SeuAplicativo.IdentificadorUnico
MS_STORE_PACKAGE_NAME=NomeDoPacote
MS_STORE_DISPLAY_NAME="Nome de Exibição do App"

